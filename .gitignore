# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local
.claude

# Prisma
# NOTE : prisma/migrations/ est VOLONTAIREMENT versionné (baseline + évolutions
# traçables, appliquées via `prisma migrate deploy` dans docker-entrypoint.sh).
# Ne jamais y ajouter de règle d'ignorance.

# Build (racine uniquement — frontend/assets/volt/vendor/**/dist/ contient de vraies librairies
# vendorisées (Bootstrap, Popper) à versionner, jamais un dossier de build à ignorer)
/dist/
/build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Temporary
tmp/
temp/

# Fichiers de travail locaux (notes, brouillons, swaps d'éditeur) — jamais versionnés
/reassort
commede.text
*.kate-swp
scratchpad/

# Exports de ventes bruts (peuvent dépasser 100 Mo, jamais du code — cf. 17/09/2026, import
# de fichiers volumineux) : ne doivent jamais entrer dans l'historique git, qui garderait ce
# poids même après suppression ultérieure.
*.csv
# Dossier local des imports manuels de fichiers de vente (backend/src/services/salesFileService.js,
# MANUAL_IMPORT_DIR) : créé dynamiquement au runtime, son contenu ne doit jamais être versionné.
backend/data/
