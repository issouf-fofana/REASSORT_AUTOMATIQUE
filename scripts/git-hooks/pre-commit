#!/usr/bin/env bash
# Incrémente automatiquement le numéro de patch (le 3e chiffre, X.Y.Z) du fichier VERSION à la
# racine du dépôt, à chaque commit — demande explicite du 13/10/2026 : "v1.0.0, v1.0.1... à chaque
# push donne moi des idée". Le major/minor (X.Y) restent toujours décidés à la main : ce hook ne
# touche jamais ces deux premiers chiffres, seulement le patch.
#
# Versionné dans scripts/git-hooks/ (contrairement à .git/hooks/, jamais versionné par Git) pour
# que tout clone du dépôt puisse réinstaller ce hook via la commande documentée dans le README du
# dossier (scripts/git-hooks/README.md) — sans ça, le hook n'existerait que sur cette machine.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/VERSION"

if [ ! -f "$VERSION_FILE" ]; then
  echo "1.0.0" > "$VERSION_FILE"
fi

CURRENT="$(cat "$VERSION_FILE" | tr -d '[:space:]')"
MAJOR="$(echo "$CURRENT" | cut -d. -f1)"
MINOR="$(echo "$CURRENT" | cut -d. -f2)"
PATCH="$(echo "$CURRENT" | cut -d. -f3)"

NEXT_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEXT_PATCH"

echo "$NEW_VERSION" > "$VERSION_FILE"
git add "$VERSION_FILE"

# Synchronise .env (VERSION=X.Y.Z, lu par docker-compose.yml au build du frontend) — .env est
# gitignored, jamais ajouté/committé ici, seulement tenu à jour localement/sur le serveur.
bash "$REPO_ROOT/scripts/sync-version-env.sh"

echo "[version] $CURRENT -> $NEW_VERSION"
