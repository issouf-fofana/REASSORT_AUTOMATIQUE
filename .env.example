# Variables lues par docker-compose.yml (dev local) ET dokploy.yaml (production). Copier en ".env"
# et personnaliser AVANT tout déploiement de production — les valeurs par défaut ("postgres") ne
# servent qu'à un premier démarrage en dev local, jamais en production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stock_auto_reappro

# --- Variables supplémentaires requises par dokploy.yaml (production uniquement) ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
# Domaine public du frontend une fois configuré dans Dockploy (onglet Domains) :
CORS_ORIGIN=https://app.tondomaine.com
# Domaine public du backend une fois configuré dans Dockploy (onglet Domains) :
BACKEND_URL=https://api.tondomaine.com
# Optionnel : fixe le compte admin créé au tout premier démarrage (sinon mot de passe généré,
# affiché une seule fois dans les logs du service "app").
ADMIN_EMAIL=
ADMIN_PASSWORD=
