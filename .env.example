# Variables lues par docker-compose.yml (racine du projet). Copier en ".env" et personnaliser
# AVANT tout déploiement de production — les valeurs par défaut ("postgres") ne servent qu'à un
# premier démarrage en dev local, jamais en production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stock_auto_reappro
