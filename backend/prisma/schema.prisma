// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// UTILISATEURS
// =============================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  // Hiérarchie de rôles (plan validé le 15/09/2026, remplace l'ancien système à 3 niveaux) :
  //   ADMIN (alias historique de SUPERADMIN, conservé pour compatibilité avec le code existant qui
  //     le teste encore à ~27 endroits — tous les magasins + configuration technique complète) ;
  //   SUPERVISOR (plusieurs magasins choisis, cf. SupervisedShop, mêmes droits IA qu'un DIRECTOR
  //     mais répétés sur chaque magasin de son périmètre, jamais de configuration) ;
  //   DIRECTOR (un seul magasin entier, tout voir/toutes les questions IA, jamais de configuration) ;
  //   DEPARTMENT_HEAD (un département assigné dans un magasin — cf. assignedDepartment ci-dessous —
  //     peut demander le CA de son département/ses articles, jamais le CA du magasin entier) ;
  //   SHELF_STOCKER (un ou plusieurs rayons assignés dans un magasin — cf. assignedDepartment —
  //     bloqué sur TOUT CA, y compris celui de ses propres articles).
  // DIRECTOR/DEPARTMENT_HEAD/SHELF_STOCKER partagent le même cloisonnement magasin que l'ancien
  // STORE (rposShopId ci-dessous) — seule la granularité département/rayon et les permissions IA
  // par capacité (aiPermissions ci-dessous) les distinguent entre eux.
  role      String   @default("DIRECTOR")

  // Rattachement au magasin RPOS (uuid, référence et nom mis en cache pour l'affichage), et au
  // serveur RPOS qui l'héberge (chaque magasin n'est joignable que via son propre serveur).
  // Utilisé pour DIRECTOR/DEPARTMENT_HEAD/SHELF_STOCKER ; null pour ADMIN/SUPERVISOR.
  rposShopId        String? @map("rpos_shop_id")
  rposShopReference String? @map("rpos_shop_reference")
  rposShopName      String? @map("rpos_shop_name")
  rposPosId         String? @map("rpos_pos_id") // ex: "pos1"

  // Département/rayon assigné (DEPARTMENT_HEAD/SHELF_STOCKER uniquement) : nom du département tel
  // que retourné par RPOS (ProposalLine.department), utilisé pour filtrer ce que le compte peut voir
  // dans les propositions et ce que l'Assistant IA peut lui montrer. Un SHELF_STOCKER peut cumuler
  // plusieurs rayons (liste séparée par virgules) — cf. plan §9 "un seul rayon par compte ?" tranché
  // en faveur du cumul pour rester réaliste (un rayonniste couvre souvent plusieurs petits rayons).
  assignedDepartment String? @map("assigned_department")

  // Permissions IA par capacité (JSON, ex: {"revenueShop": false, "revenueArticle": true, ...}) —
  // réglage fin qui part d'un défaut par rôle (cf. aiPermissionsService.js) mais peut être ajusté
  // au cas par cas par un ADMIN pour un utilisateur précis, sans changer son rôle. null = utilise
  // uniquement le défaut de son rôle, jamais recalculé/écrasé automatiquement une fois personnalisé.
  aiPermissionsJson String? @map("ai_permissions_json")

  isActive  Boolean  @default(true) @map("is_active")

  // true si ce compte a été créé automatiquement au premier login réussi contre l'Active Directory
  // Prosuma (STEP 10) plutôt que créé à la main par un ADMIN — sert uniquement à distinguer, dans
  // l'écran Utilisateurs, "en attente de validation après un login LDAP" d'un compte local que
  // quelqu'un a délibérément désactivé (les deux ont isActive=false, mais des raisons différentes).
  ldapManaged Boolean @default(false) @map("ldap_managed")

  supervisedShops SupervisedShop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// =============================================
// MAGASINS SUPERVISÉS (readme §29 : profil superviseur intermédiaire, suit plusieurs magasins
// choisis sans avoir l'accès complet d'un ADMIN à tous les magasins)
// =============================================
model SupervisedShop {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rposShopId        String @map("rpos_shop_id")
  rposShopReference String @map("rpos_shop_reference")
  rposShopName      String @map("rpos_shop_name")
  rposPosId         String @map("rpos_pos_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, rposShopId])
  @@map("supervised_shops")
}

// =============================================
// SERVEURS RPOS (un magasin RPOS ne peut être joint que via son propre serveur/instance ;
// chaque serveur a ses propres identifiants de connexion, cf. readme section 24)
// =============================================
model RposServer {
  id       String @id @default(cuid())
  posId    String @unique @map("pos_id") // identifiant technique, ex: "pos1"
  label    String // ex: "Serveur Prosuma Prod1"
  baseUrl  String @map("base_url") // ex: https://pos1-prod-prosuma.prosuma.pos

  rposUser     String? @map("rpos_user")
  rposPassword String? @map("rpos_password") // jamais renvoyé en clair par l'API, cf. systemConfigService

  isActive Boolean @default(true) @map("is_active") // false tant qu'aucun identifiant n'a été configuré

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rpos_servers")
}

// Copie locale de la liste des magasins par serveur RPOS (readme évolution : le menu déroulant
// "Magasin" interrogeait RPOS en direct sur les 18 serveurs à chaque premier chargement de page,
// jusqu'à 15-20s de latence). Synchronisée périodiquement en tâche de fond (shopsSyncJob.js) : les
// pages consultent cette table plutôt que RPOS, la liste des magasins changeant très rarement.
model Shop {
  id String @id @default(cuid()) // clé locale, différente de rposShopId

  rposShopId String @unique @map("rpos_shop_id") // UUID RPOS du magasin
  rposPosId  String @map("rpos_pos_id")
  reference  String // code magasin, ex: "110"
  name       String // ex: "SUPER U VALLON"

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([rposPosId])
  @@map("shops")
}

// Cache local des infos produit RPOS (/api/product/ par EAN), pour éviter un appel RPOS par
// article à chaque génération de proposition (jusqu'à 700+ appels séquentiels/parallèles sur un
// gros magasin, dominant largement le temps total malgré les ventes déjà locales). Peuplé "à la
// demande" (cache-aside) : un article est mis en cache la première fois qu'il est vu dans une
// génération, puis relu depuis cette table tant qu'il n'a pas expiré (TTL court car le stock change
// en continu), sans job de synchro séparé à gérer — pas besoin de précharger tout un catalogue.
model ProductCache {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")
  ean        String

  productId    String  @map("rpos_product_id")
  orderable    Boolean
  sellingPrice Float   @map("selling_price")
  buyingPrice  Float   @map("buying_price")
  orderingUnit Float   @map("ordering_unit")
  stock        Float
  departmentId String? @map("department_id")

  syncedAt DateTime @default(now()) @map("synced_at")

  @@unique([rposShopId, ean])
  @@map("product_cache")
}

// DLV actives (Date Limite de Vente courte, endpoint RPOS end_of_life_product — investigué le
// 22/09/2026 : PAS une date de péremption automatique, mais un geste manuel du personnel qui
// scinde le stock d'un article en deux compteurs : une partie reste au stock normal (prix plein),
// une partie bascule sur un EAN "DLV" distinct (product_ean pointe vers l'article d'origine), vendu
// à prix réduit (sellingPrice < originSellingPrice) jusqu'à écoulement. Synchronisée localement
// (comme SalesLine) plutôt que lue en direct à chaque génération de proposition, pour ne jamais
// ralentir/bloquer un calcul de réassort sur un appel RPOS supplémentaire. Sert à retirer ce stock
// DLV du stock "normal" pris en compte pour calculer la quantité à recommander de l'article
// d'origine (proposalService.js) : un stock qui traîne en DLV ne doit jamais masquer un vrai besoin
// de réassort de l'article normal.
model ProductEndOfLife {
  id String @id @default(cuid())

  rposId     String @unique @map("rpos_id") // id RPOS de la fiche DLV elle-même (dédup à la resynchro)
  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")

  dlvEan      String @map("dlv_ean") // EAN propre à cette fiche DLV (distinct de l'article d'origine)
  originEan   String @map("origin_ean") // EAN de l'article normal concerné (product_ean côté RPOS)
  label       String?
  dlvStock    Float  @map("dlv_stock") // quantité basculée en DLV, à retirer du stock normal
  sellingPrice Float? @map("selling_price") // prix réduit de vente en DLV, pour affichage seulement

  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([rposShopId, originEan])
  @@map("product_end_of_life")
}

// Cache du résultat de getRecentUndeliveredOrderedQuantity (commandes RPOS récentes ≤7j non
// livrées par article, hors plateforme) : second appel RPOS par article, aussi coûteux que
// ProductCache et jusqu'ici non caché, restait le vrai goulot après l'ajout de ProductCache
// (mesuré : ~30% de gain avec ProductCache seul, ce second appel domine ensuite). Même principe
// cache-aside, même TTL — un reliquat de commande évolue lentement (délai de 7 jours de marge),
// donc pas besoin d'une fraîcheur plus fine que celle du stock.
model RecentOrderCache {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")
  productId  String @map("rpos_product_id")

  quantity           Float
  orderCount         Int    @default(0) @map("order_count")
  mostRecentDate     DateTime? @map("most_recent_date")
  mostRecentReference String?  @map("most_recent_reference")
  // Statut RPOS de la commande la plus récente (1=en préparation, 2=validée/en attente de
  // livraison, 6=annulée) : affiché sur le badge "commandé le X" pour distinguer une commande
  // simplement créée d'une commande réellement transmise à l'entrepôt.
  mostRecentStatus   Int?     @map("most_recent_status")
  ordersJson         String?  @map("orders_json") // détail des commandes (JSON), pour le badge "commandé le X" — sérialisé faute de type JSON portable simple ici

  syncedAt DateTime @default(now()) @map("synced_at")

  @@unique([rposShopId, productId])
  @@map("recent_order_cache")
}

// Profil d'activité d'un magasin (shopActivityService.js) : permet à l'IA de distinguer un article
// peu vendu dans un magasin actif d'un magasin qui ne fonctionne plus (fermé, en pause, jamais
// démarré) — construit par échantillonnage RPOS mensuel, mis en cache car le statut d'un magasin
// ne change pas d'heure en heure.
model ShopActivityProfile {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @unique @map("rpos_shop_id")

  status      String // ACTIVE | RESUMED | INACTIVE | NEVER_ACTIVE
  profileJson String @map("profile_json") // détail complet (mois échantillonnés, dernière activité...) pour affichage "Pourquoi ?"

  computedAt DateTime @default(now()) @updatedAt @map("computed_at")

  @@map("shop_activity_profile")
}

// =============================================
// CONFIGURATION DU RÉASSORT (paramétrable par magasin, cf. page Paramètres)
// =============================================
model ReassortConfig {
  id String @id @default(cuid())

  rposShopId String @unique @map("rpos_shop_id")

  // Seuil de contribution cumulée au CA retenu pour l'analyse Pareto (0.80 = 80%)
  paretoThreshold Float @default(0.80) @map("pareto_threshold")

  // Ratio de stock de sécurité appliqué sur la vente moyenne de la période (0.5 = 50%)
  safetyStockRatio Float @default(0.5) @map("safety_stock_ratio")

  // Mode de période d'analyse des ventes : YESTERDAY, LAST_7_DAYS, LAST_30_DAYS, CUSTOM
  // Toujours calculé relativement à la dernière vente connue du magasin (pas à "aujourd'hui"),
  // pour rester pertinent même sur un magasin fermé ou dont les ventes RPOS ont du retard.
  periodMode  String    @default("LAST_30_DAYS") @map("period_mode")
  customStart DateTime? @map("custom_start")
  customEnd   DateTime? @map("custom_end")

  // Si vrai (comportement historique), un stock négatif (anomalie de suivi RPOS) est ramené à 0
  // avant calcul du besoin. Si faux, la valeur négative réelle est conservée et affichée telle quelle.
  treatNegativeStockAsZero Boolean @default(true) @map("treat_negative_stock_as_zero")

  // Si vrai, la génération n'appelle jamais RPOS pour le stock/prix/colisage d'un article déjà vu
  // au moins une fois (ProductCache utilisé même très périmé, TTL ignoré) — permet de générer une
  // proposition en étant hors du réseau Prosuma, au prix d'un stock potentiellement obsolète (mis à
  // 0 dans le calcul plutôt qu'utilisé comme une vraie valeur non fiable). Un article jamais vu reste
  // exclu, faute de prix/colisage connus. Off par défaut.
  ignoreRposStockInCalculation Boolean @default(false) @map("ignore_rpos_stock_in_calculation")

  // Nombre de jours de la période de référence utilisée pour calculer la part de CA de chaque
  // article proposé par rapport au CA total du magasin (ex: 1 = hier, 7 = 7 derniers jours).
  revenueSharePeriodDays Int @default(1) @map("revenue_share_period_days")

  // Multiplicateur appliqué au besoin théorique (vente moyenne + stock de sécurité) au-delà duquel
  // une quantité commandée est considérée en surstock pour le calcul du KPI "Taux de surstock"
  // (ex: 1.5 = commander 50% de plus que le besoin théorique est considéré comme du surstock).
  overstockThresholdMultiplier Float @default(1.5) @map("overstock_threshold_multiplier")

  // Si vrai, la validation crée une commande fournisseur RPOS distincte par rayon (readme §11).
  // Si faux, tous les articles sélectionnés partent dans une seule commande globale (comportement
  // historique), utile pour les magasins/fournisseurs qui ne séparent pas leurs commandes par rayon.
  splitOrdersByDepartment Boolean @default(true) @map("split_orders_by_department")

  // Précision des prévisions (readme §17) : une ligne validée n'est évaluable qu'une fois cette
  // fenêtre de temps écoulée depuis la validation, le temps que les ventes réelles se produisent.
  forecastAccuracyWindowDays Int @default(7) @map("forecast_accuracy_window_days")

  // Écart toléré (en %) entre la vente moyenne prévue et la vente réelle constatée sur la fenêtre
  // ci-dessus pour qu'une ligne soit comptée comme "prévision précise" (ex: 20 = ±20% toléré).
  forecastAccuracyThresholdPct Float @default(20) @map("forecast_accuracy_threshold_pct")

  // Saisonnalité (readme §8) : si vrai, la génération de proposition compare en plus la période
  // d'analyse actuelle à la même période N années en arrière (ex: décembre N vs décembre N-1),
  // pour ajuster la vente moyenne prévue si une tendance saisonnière significative est détectée.
  // Fonctionne sur la période de référence du magasin (dernière vente connue, jamais la date
  // système), donc valable aussi bien en test sur des données anciennes qu'en production.
  seasonalityComparisonEnabled Boolean @default(false) @map("seasonality_comparison_enabled")

  // Nombre d'années en arrière pour la comparaison saisonnière (1 = l'année dernière).
  seasonalityLookbackYears Int @default(1) @map("seasonality_lookback_years")

  // Si l'écart de vente entre la période actuelle et la période N-1 dépasse ce seuil (en %), la
  // vente moyenne prévue est ajustée à la hausse ou à la baisse en conséquence (cf. readme §8 :
  // éviter de sous-estimer une période de forte demande comme Pâques ou Noël).
  seasonalityAdjustmentThresholdPct Float @default(15) @map("seasonality_adjustment_threshold_pct")

  // Délai moyen de réception des commandes pour ce magasin, en jours (0 = réception le jour même).
  // Sert à préremplir la date de livraison proposée à la validation, et à couvrir le besoin sur
  // cette durée plutôt que sur une semaine fixe implicite : plus le délai est long, plus il faut
  // commander en avance pour ne pas tomber en rupture avant l'arrivée de la marchandise.
  receptionLeadTimeDays Int @default(1) @map("reception_lead_time_days")

  // Si vrai, le besoin est calculé pour couvrir le délai de réception (ventes/jour × délai) au
  // lieu d'une semaine fixe implicite. Désactivé par défaut : change le résultat du calcul pour
  // tous les articles du magasin, à activer explicitement après validation sur un magasin pilote.
  useReceptionLeadTimeInCalculation Boolean @default(false) @map("use_reception_lead_time_in_calculation")

  // Exclut du calcul de proposition tout article dont le prix de vente est strictement inférieur
  // à ce seuil (en CFA) : sert à écarter les articles génériques/poids libre agrégés au niveau
  // d'un rayon entier (ex: "FRUITS & LEGUMES" à 1 CFA/unité, qui n'est pas un vrai produit
  // individuel et fausse totalement le calcul avec des quantités proposées énormes). 0 = désactivé.
  excludeGenericArticlesBelowPrice Float @default(2) @map("exclude_generic_articles_below_price")

  // Au-delà de ce délai, une commande fournisseur RPOS jamais marquée "livrée" n'est plus prise en
  // compte comme "déjà commandé" dans le calcul du besoin : sur les commandes centrales, RPOS ne
  // reflète jamais la réception réelle, donc des commandes très anciennes (parfois plusieurs mois)
  // restaient indéfiniment "en attente" et bloquaient à tort le réassort d'un article pourtant
  // épuisé depuis longtemps (bug identifié : commandes de 3+ mois bloquant encore l'article).
  recentOrderMaxAgeDays Int @default(3) @map("recent_order_max_age_days")

  // Prévision de vente moyenne par lissage exponentiel (readme évolution "intégration IA"), en
  // remplacement de la moyenne plate sur toute la période — cf. forecastService.js. Désactivé par
  // défaut pour ne pas changer le comportement des magasins déjà actifs sans validation explicite.
  forecastEnabled Boolean @default(false) @map("forecast_enabled")
  // Poids donné à la journée la plus récente (0 à 1) : plus proche de 1 = réagit plus vite aux
  // ventes récentes, plus proche de 0 = lisse davantage. Retombe automatiquement sur la moyenne
  // plate si l'historique dispo est trop court (cf. forecastService.MIN_DAYS_FOR_SMOOTHING).
  forecastAlpha Float @default(0.3) @map("forecast_alpha")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("reassort_configs")
}

// Suivi de progression d'une génération de proposition en tâche de fond (bouton "Forcer une
// nouvelle génération") : la génération pouvant prendre de quelques secondes à plusieurs minutes
// (appel RPOS pour l'historique de ventes, calcul article par article), l'ancien comportement
// bloquait la requête HTTP jusqu'à la fin et affichait une barre de progression simulée
// (setTimeout) côté frontend, sans lien avec l'avancement réel. Ce modèle permet de répondre
// immédiatement au clic et de suivre la vraie progression via polling (même principe que
// Proposal.linesTotal/linesProcessed pour la validation).
model ProposalGenerationRun {
  id String @id @default(cuid())

  rposShopId String @map("rpos_shop_id")

  status String @default("RUNNING") // RUNNING -> DONE -> ERROR
  // Étape en cours, alignée sur les 3 étapes déjà affichées côté UI : SALES (analyse des ventes,
  // avant que le nombre total d'articles à traiter soit connu) -> PARETO (classement) ->
  // QUANTITIES (calcul par article, seule étape avec un vrai compteur X/Y) -> DONE.
  step String @default("SALES")

  articlesTotal     Int @default(0) @map("articles_total")
  articlesProcessed Int @default(0) @map("articles_processed")
  // Dernier article traité (EAN + libellé), pour afficher "en cours : ..." plutôt qu'un compteur
  // seul — répond à la demande de voir "les articles qu'il a fini de faire".
  lastArticleEan   String? @map("last_article_ean")
  lastArticleLabel String? @map("last_article_label")

  proposalId   String? @map("proposal_id") // renseigné une fois la proposition créée (statut DONE)
  errorMessage String? @map("error_message")

  // Renseigné à l'étape AI_ADJUSTMENT : distingue un ajustement IA réellement effectué d'un repli
  // intégral sur le calcul classique (ex: crédit API épuisé) — sans ça, le modal de progression
  // affichait "Analyse IA des quantités ✓ Terminé" même quand aucun article n'a été analysé par
  // l'IA, ce qui donnait l'illusion trompeuse d'un succès.
  aiUnavailable      Boolean? @map("ai_unavailable")
  aiArticlesAdjusted Int?     @map("ai_articles_adjusted")
  aiErrorMessage     String?  @map("ai_error_message")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([rposShopId, createdAt])
  @@map("proposal_generation_run")
}

// =============================================
// PROPOSITIONS DE RÉASSORT (historisation, cf. readme section 16)
// =============================================
model Proposal {
  id        String   @id @default(cuid())

  // Magasin RPOS concerné (uuid, référence et nom mis en cache pour l'affichage), et serveur RPOS
  rposShopId        String  @map("rpos_shop_id")
  rposShopReference String  @map("rpos_shop_reference")
  rposShopName      String  @map("rpos_shop_name")
  rposPosId         String? @map("rpos_pos_id")

  // Statut du cycle de vie : GENERATED (calculée, en attente) -> VALIDATING (envoi en cours vers
  // RPOS, en tâche de fond) -> VALIDATED (terminé) ou VALIDATION_FAILED -> REJECTED (écrasée par
  // une nouvelle génération sans avoir été traitée)
  status    String   @default("GENERATED")

  generatedAt DateTime @default(now()) @map("generated_at")
  validatedAt DateTime? @map("validated_at")
  validatedBy String?   @map("validated_by") // email de l'utilisateur ayant validé

  // Progression de l'envoi en tâche de fond vers RPOS (nombre de lignes traitées / total)
  linesTotal     Int? @map("lines_total")
  linesProcessed Int? @map("lines_processed")
  linesFailed    Int? @map("lines_failed")
  validationError String? @map("validation_error")

  // Référence de la première commande RPOS créée lors de la validation (conservé pour compat avec
  // les lookups existants) ; le détail complet par rayon (readme §11) est dans ProposalOrder.
  rposOrderId        String? @map("rpos_order_id")
  rposOrderReference String? @map("rpos_order_reference")

  // Si vrai, la commande a en plus été validée sur RPOS (transmise à l'entrepôt) après sa création,
  // en fonction du choix fait par l'utilisateur au moment de la validation (voir readme §9-10).
  // null si non applicable (validation non demandée) ; false si demandée mais échouée.
  rposOrderValidated Boolean? @map("rpos_order_validated")

  // CA total du magasin sur la période de référence utilisée pour la colonne "% CA magasin"
  // (ReassortConfig.revenueSharePeriodDays), pour donner un contexte au pourcentage affiché
  // par ligne (ex: "71% de quoi ?").
  revenueShareStart   DateTime? @map("revenue_share_start")
  revenueShareEnd     DateTime? @map("revenue_share_end")
  shopTotalRevenue    Float?    @map("shop_total_revenue")
  // CA TTC équivalent, affiché à côté du HT ci-dessus (demande du 15/09/2026) : le rapport de
  // caisse RPOS raisonne en TTC, alors que shopTotalRevenue (HT) sert au calcul Pareto/% CA par
  // article — afficher les deux évite de faire croire à tort à un écart de données entre l'appli
  // et RPOS quand ce n'est qu'une différence HT/TTC.
  shopTotalRevenueInclTax Float? @map("shop_total_revenue_incl_tax")

  // Période d'analyse des ventes utilisée pour le classement Pareto et le calcul de la vente
  // moyenne (distincte de revenueShareStart/End ci-dessus, qui sert uniquement à la colonne "% CA
  // magasin"). Persistée pour pouvoir expliquer a posteriori "sur quelles ventes cette proposition
  // se base" (évolution : période de référence des commandes).
  analysisPeriodStart DateTime? @map("analysis_period_start")
  analysisPeriodEnd   DateTime? @map("analysis_period_end")
  analysisPeriodMode  String?   @map("analysis_period_mode")

  // Couverture RÉELLE des données de vente utilisées (peut être plus étroite qu'analysisPeriodStart
  // ci-dessus, ex: base locale avec un trou d'historique jamais comblé) : à afficher en priorité à
  // l'utilisateur plutôt que la période configurée en arrière-plan, pour qu'il sache concrètement
  // sur quelle période le calcul a réellement porté et juge lui-même s'il faut relancer un backfill
  // avant de faire confiance à la proposition. null si aucune vente trouvée du tout dans la période.
  actualDataStart DateTime? @map("actual_data_start")
  actualDataEnd   DateTime? @map("actual_data_end")
  coverageGapDays Int?      @default(0) @map("coverage_gap_days")

  // Paramètres de calcul effectivement appliqués à cette génération (peuvent différer de la
  // configuration actuelle du magasin si elle a changé depuis) : nécessaires pour reconstruire
  // l'explication du calcul d'une proposition ancienne de façon fiable.
  paretoThresholdUsed         Float? @map("pareto_threshold_used")
  safetyStockRatioUsed        Float? @map("safety_stock_ratio_used")
  receptionLeadTimeDaysUsed   Int?   @map("reception_lead_time_days_used")

  // Détail du nombre d'articles écartés par raison (readme évolution "vue par secteur/rayon" :
  // affiche pourquoi le "Reste du CA magasin" non proposé n'est pas à 0%, sans faire varier son
  // calcul — qui reste 100% − somme des % CA affichés par carte). Persisté à la génération car ces
  // compteurs ne sont sinon disponibles qu'en mémoire le temps du calcul (result.stats).
  totalArticlesWithSales   Int? @map("total_articles_with_sales")
  skippedNotFound          Int? @map("skipped_not_found")
  skippedNotOrderable      Int? @map("skipped_not_orderable")
  skippedNegativeStock     Int? @map("skipped_negative_stock")
  skippedAlreadyOrdered    Int? @map("skipped_already_ordered")
  skippedGenericArticle    Int? @map("skipped_generic_article")

  lines           ProposalLine[]
  orders          ProposalOrder[]
  excludedArticles ExcludedArticle[]
  predictions     AIPrediction[]
  orderAnomalies  OrderAnomaly[]

  // Rattache cette génération à une semaine cible (CAHIER_DES_CHARGES.md §11-13, étape 1 du plan) :
  // une Proposal reste le mécanisme de calcul/validation existant, inchangé ; weeklyPlanId l'associe
  // en plus à un WeeklyReplenishmentPlan qui, lui, survit aux régénérations successives de la même
  // semaine (chaque nouvelle génération pour cette semaine devient une révision de plan, au lieu de
  // remplacer purement et simplement l'ancienne Proposal comme c'était le cas avant cette étape).
  weeklyPlanId String?                 @map("weekly_plan_id")
  weeklyPlan   WeeklyReplenishmentPlan? @relation(fields: [weeklyPlanId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rposShopId, generatedAt])
  // getAdminDashboard/getConformityRate/getStockoutRate/getOverstockRate/getForecastAccuracy
  // filtrent tous sur (rposShopId, status) avant de trier par validatedAt (audit performance :
  // aucun index dédié n'existait, ces requêtes reposaient sur un scan complet de la table).
  @@index([rposShopId, status, validatedAt])
  @@index([weeklyPlanId])
  @@map("proposals")
}

// =============================================
// PLAN DE RÉASSORT HEBDOMADAIRE (CAHIER_DES_CHARGES.md §11 — étape 1 du plan)
// =============================================
// Avant cette étape, chaque génération de Proposal remplaçait purement et simplement la précédente
// (passage à REJECTED) : aucun lien ne subsistait entre "ce qui était prévu lundi" et "ce qu'on
// recalcule jeudi avec les ventes des jours écoulés". Un WeeklyReplenishmentPlan regroupe toutes
// les Proposal générées pour une même semaine cible d'un même magasin, permettant de :
// - garder l'historique des révisions successives de la même semaine (§12-13), au lieu de perdre
//   la proposition initiale à chaque nouvelle génération ;
// - distinguer une commande déjà validée (Proposal.status=VALIDATED) des révisions ultérieures qui
//   ne recalculent alors plus que le besoin RESTANT (§14), pas encore implémenté à cette étape.
// Cette étape ne modifie ni le calcul (proposalService.js), ni la validation, ni l'envoi RPOS,
// ni le frontend existant : elle ajoute uniquement le rattachement d'une Proposal à sa semaine
// cible, base nécessaire aux étapes suivantes (révisions explicites, réajustement quotidien).
model WeeklyReplenishmentPlan {
  id String @id @default(cuid())

  rposShopId        String @map("rpos_shop_id")
  rposShopReference String @map("rpos_shop_reference")
  rposPosId         String @map("rpos_pos_id")

  // Semaine cible que ce plan couvre (ex: lundi 8 septembre -> dimanche 14 septembre), distincte de
  // la période d'ANALYSE des ventes passées (Proposal.analysisPeriodStart/End) qui sert à calculer
  // le besoin : cf. CAHIER_DES_CHARGES.md §55 ("Analyse : 1 → 7 septembre, Cible : 8 → 14 septembre").
  targetWeekStart DateTime @map("target_week_start")
  targetWeekEnd   DateTime @map("target_week_end")

  // Un seul plan actif par magasin et par semaine cible : une nouvelle génération pour la même
  // semaine doit rattacher sa Proposal au plan existant (nouvelle révision) plutôt que d'en créer
  // un second en doublon.
  status String @default("ACTIVE") // ACTIVE (en cours de semaine) -> CLOSED (semaine passée)

  revisions Proposal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rposShopId, targetWeekStart])
  @@index([rposShopId, status])
  @@map("weekly_replenishment_plans")
}

// =============================================
// HISTORIQUE DES PRÉDICTIONS (CAHIER_DES_CHARGES.md §21 — étape 4 du plan)
// =============================================
// Jusqu'à cette étape, la prévision de vente calculée pour chaque article (avgWeeklySales,
// forecastMethod) n'existait qu'en tant qu'entrée de ProposalLine, couplée à la proposition qui en
// résulte (quantité à commander, stock au moment du calcul...). AIPrediction isole la PRÉDICTION
// elle-même (ce que le système anticipe comme demande, indépendamment de la décision de commande)
// pour permettre plus tard (étape 5, AIPredictionOutcome) de comparer prédiction vs réalité une
// fois la période cible écoulée. Une ligne par (proposition, article) : pas de nouveau calcul, on
// persiste simplement ce que generateProposal a déjà produit pour cette proposition.
model AIPrediction {
  id String @id @default(cuid())

  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  rposShopId String @map("rpos_shop_id")
  ean        String
  label      String?

  predictionDate DateTime @default(now()) @map("prediction_date")

  // Semaine cible de la prédiction (= WeeklyReplenishmentPlan.targetWeekStart/End rattaché à la
  // proposition), distincte de predictionDate qui est le moment où le calcul a été fait.
  targetPeriodStart DateTime? @map("target_period_start")
  targetPeriodEnd   DateTime? @map("target_period_end")

  predictedWeeklyDemand Float @map("predicted_weekly_demand")
  predictedDailyDemand  Float @map("predicted_daily_demand")
  predictedQuantity     Int   @map("predicted_quantity") // quantité proposée à la commande (ProposalLine.quantitySuggested)

  stockAtPrediction  Float @map("stock_at_prediction")
  ordersAtPrediction Float @map("orders_at_prediction") // quantité déjà en commande au moment du calcul (currentOrderedQuantity)

  // "Modèle" au sens large : méthode de prévision utilisée pour CETTE ligne (lissage exponentiel ou
  // "flat" si historique trop court, cf. forecastService.MIN_DAYS_FOR_SMOOTHING) — pas encore de
  // véritable modèle IA distinct à cette étape (étapes 6-8 du plan).
  model        String  @default("smoothing")
  modelVersion String? @map("model_version")

  // Pas de score de confiance calculé à cette étape (étape 6, Confidence Engine) : colonne posée
  // dès maintenant pour ne pas devoir migrer AIPrediction une seconde fois.
  confidenceScore Float?  @map("confidence_score")
  reasoning       String? // explication humaine courte, ex: "lissage exponentiel sur 42 jours d'historique"
  // Type d'action structuré (§18), copie de ProposalLine.aiAction au moment de la génération —
  // null si l'IA n'a pas tourné pour cette ligne (repli sur le calcul classique).
  action          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rposShopId, ean, predictionDate])
  @@index([proposalId])
  @@map("ai_predictions")

  outcome AIPredictionOutcome?
}

// =============================================
// RÉSULTAT RÉEL VS PRÉDICTION (CAHIER_DES_CHARGES.md §22 — étape 5 du plan)
// =============================================
// Une fois la période cible d'une AIPrediction terminée (targetPeriodEnd dépassé), un job planifié
// compare la prédiction à ce qui s'est réellement passé : ventes réelles sur la période (SalesLine,
// déjà synchronisées localement — aucun appel RPOS), stock actuel en cache (ProductCache — le stock
// exact à la fin de la période cible n'est pas historisé, seul le stock au moment du calcul de
// clôture est disponible, limite assumée à cette étape). Une seule mesure de performance : rien ne
// modifie encore le comportement du système (pas d'ajustement automatique de confiance, ce sera
// l'étape 6, Confidence Engine) — cette table sert uniquement à observer la fiabilité des
// prédictions dans le temps.
model AIPredictionOutcome {
  id String @id @default(cuid())

  predictionId String       @unique @map("prediction_id")
  prediction   AIPrediction @relation(fields: [predictionId], references: [id])

  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  predictedQuantity Int   @map("predicted_quantity") // copie de AIPrediction.predictedQuantity au moment de l'évaluation
  actualSales       Float @map("actual_sales") // somme des quantités vendues (SalesLine) sur la période cible
  actualStock       Float? @map("actual_stock") // stock en cache au moment de l'évaluation (cf. limite ci-dessus)
  actualOrders      Float? @map("actual_orders") // quantité effectivement commandée sur la proposition (ProposalLine.quantitySuggested si validée)

  // forecastError = actual - predicted (signé : positif = sous-estimation, négatif = sur-estimation)
  forecastError Float @map("forecast_error")
  // absoluteError = abs(forecastError)
  absoluteError Float @map("absolute_error")
  // percentageError = abs(actual - predicted) / actual — null si actual = 0 (division impossible,
  // cf. CAHIER_DES_CHARGES.md §22 "gérer correctement les cas où actual = 0").
  percentageError Float? @map("percentage_error")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([evaluatedAt])
  @@map("ai_prediction_outcomes")
}

// =============================================
// ARTICLES EXCLUS (détail par article de la carte "Reste du CA magasin")
// =============================================
// Les compteurs Proposal.skipped* donnent un total par raison, mais pas le détail des articles
// concernés ni leur part de CA individuelle. Persisté à la génération (comme les compteurs) car
// ce détail n'est sinon disponible qu'en mémoire le temps du calcul (result.skipped).
model ExcludedArticle {
  id         String   @id @default(cuid())
  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  ean              String
  label            String?
  revenueSharePct  Float?  @map("revenue_share_pct")
  reason           String  // notFound | notOrderable | negativeStock | alreadyOrdered | genericArticle

  @@index([proposalId, reason])
  @@map("excluded_articles")
}

// =============================================
// COMMANDES PAR RAYON (readme §11)
// =============================================
// Une proposition validée génère une commande fournisseur RPOS distincte par rayon (au lieu
// d'une seule commande globale), pour respecter le processus métier existant qui sépare les
// commandes par rayon (Épicerie, Boissons, Produits frais, etc.).
model ProposalOrder {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  department String // rayon principal (ex: "PRODUITS FRAIS")

  rposOrderId        String? @map("rpos_order_id")
  rposOrderReference String? @map("rpos_order_reference")
  rposOrderValidated Boolean? @map("rpos_order_validated")

  linesTotal    Int @default(0) @map("lines_total")
  linesFailed   Int @default(0) @map("lines_failed")
  status        String @default("PENDING") // statut d'envoi technique : PENDING -> DONE -> FAILED -> CANCELLED
  errorMessage  String? @map("error_message")

  // Statut métier de réception (distinct du statut d'envoi ci-dessus) : COMMANDEE (créée sur RPOS,
  // pas encore transmise) -> EN_ATTENTE_RECEPTION (transmise à l'entrepôt) -> RECUE_ESTIMEE ou
  // ANNULEE. IMPORTANT : le statut RPOS de supplier_order N'EST PAS un indicateur fiable de
  // réception réelle (une commande peut rester "en attente de livraison" alors que la marchandise
  // est déjà livrée) ; la vraie confirmation viendrait de l'intégration de facture magasin
  // (/api/delivery/), mais les commandes de cette plateforme passent par le fournisseur central,
  // qui ne génère jamais de réception dans RPOS. RECUE_ESTIMEE est donc une ESTIMATION basée sur
  // le délai de réception configuré du magasin, jamais une confirmation certaine — à toujours
  // présenter comme telle côté UI. Seule ANNULEE reste vérifiée de façon fiable (statut RPOS 6).
  receptionStatus String @default("COMMANDEE") @map("reception_status")

  // Date de réception prévue = date de validation + ReassortConfig.receptionLeadTimeDays du
  // magasin au moment de la création (figée, ne bouge pas si le délai magasin change ensuite).
  expectedReceptionDate DateTime? @map("expected_reception_date")

  // Renseignée dès que receptionStatus atteint RECUE_ESTIMEE (date du passage en estimé, pas une
  // date de réception réelle confirmée) ou ANNULEE.
  actualReceptionDate DateTime? @map("actual_reception_date")

  // Dernier statut RPOS numérique observé (1-6) et horodatage de la dernière synchronisation,
  // pour savoir si une commande n'a pas été revérifiée depuis longtemps.
  lastRposStatus    Int?      @map("last_rpos_status")
  lastSyncedAt      DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  receptionEvents ReceptionEvent[]

  @@map("proposal_orders")
}

// =============================================
// ÉVÉNEMENTS DE RÉCEPTION (historique des changements de statut de réception observés)
// =============================================
// Trace chaque passage à ANNULEE (fiable, statut RPOS 6) ou à RECUE_ESTIMEE (estimation basée sur
// le délai de réception configuré, PAS une confirmation réelle — cf. commentaire sur
// ProposalOrder.receptionStatus). rposStatus vaut -1 quand la transition vient du délai plutôt
// que d'une lecture RPOS.
model ReceptionEvent {
  id              String        @id @default(cuid())
  proposalOrderId String
  proposalOrder   ProposalOrder @relation(fields: [proposalOrderId], references: [id], onDelete: Cascade)

  rposStatus      Int      // statut RPOS observé (1-6), ou -1 si la transition vient du délai configuré
  receptionStatus String   // statut métier correspondant, pour lecture directe sans re-mapper
  observedAt      DateTime @default(now()) @map("observed_at")

  @@map("reception_events")
}

// =============================================
// LIGNES DE PROPOSITION
// =============================================
model ProposalLine {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  ean       String
  label     String
  productId String @map("rpos_product_id") // uuid produit RPOS

  // Quantité FINALE proposée au magasin (celle affichée dans "Qté proposée") — la recommandation
  // de l'IA si elle a pu tourner à la génération, sinon repli sur classicQuantitySuggested (jamais
  // de génération bloquée faute de clé API/réseau IA). Puis quantité finalement validée par
  // l'humain (== quantitySuggested si l'utilisateur n'a rien modifié : sert au calcul du taux de
  // conformité).
  quantitySuggested Float @map("quantity_suggested")
  quantityValidated Float? @map("quantity_validated")
  // Copie figée de quantitySuggested telle que produite par la génération (IA ou repli classique),
  // AVANT toute correction manuelle via PUT /proposal/:id/line-quantity — qui écrase quantitySuggested
  // en place. Sans ce snapshot, la recommandation d'origine était perdue dès qu'un utilisateur
  // ajustait la quantité, rendant impossible toute comparaison a posteriori "l'IA avait-elle raison ?"
  // (Mode Simulation / Shadow AI, phase 1 — 22/09/2026). Renseigné une seule fois à la création de la
  // ligne, jamais modifié ensuite.
  quantityAiOriginal Float? @map("quantity_ai_original")

  // Résultat de computeQuantityToOrder (vente moyenne + stock de sécurité - stock actuel -
  // commandes en cours), TOUJOURS calculé et conservé même quand l'IA ajuste la recommandation
  // finale : sert de base de calcul transmise à l'IA (systemSuggestedQuantity côté prompt) et de
  // repère de comparaison affiché dans le panneau détail ("Pourquoi ?", section calcul classique).
  classicQuantitySuggested Float? @map("classic_quantity_suggested")
  // true si quantitySuggested provient réellement d'un appel IA réussi à la génération (par
  // opposition à un repli silencieux sur classicQuantitySuggested faute d'IA disponible) : affiché
  // dans "Pourquoi ?" pour ne jamais faire croire à une analyse IA qui n'a pas eu lieu.
  aiAdjusted        Boolean @default(false) @map("ai_adjusted")
  aiReasoning       String? @map("ai_reasoning") // explication de l'IA pour cette quantité finale, si aiAdjusted=true
  // Type d'action structuré (CAHIER_DES_CHARGES.md §18) : ORDER_NOW | ORDER_MORE | ORDER_LESS |
  // WAIT | STOCK_RISK | OVERSTOCK | DEMAND_INCREASE | DEMAND_DECREASE | ANOMALY | VERIFY_STOCK |
  // NO_ACTION. Renseigné uniquement si aiAdjusted=true (l'IA a réellement tourné) — jamais déduit
  // ou inventé côté backend si l'IA n'a pas répondu ce champ.
  aiAction          String? @map("ai_action")

  // Raisonnement déterministe (pas l'IA) expliquant si une commande RPOS/POS déjà en cours pour
  // cet article suffit à couvrir le besoin ou non (backend/amelioration.md, demande du 18/09/2026 :
  // "il doit voir la quantité commandée... et me dire que la quantité commandée en premier est
  // insuffisante"). Distinct de aiReasoning (celui-ci vient du LLM, sur la quantité finale ; celui-ci
  // est calculé, sur la suffisance d'une commande déjà passée). Null si aucune commande en cours.
  orderSufficiencyReasoning String?  @map("order_sufficiency_reasoning")
  // true = suffisant, false = insuffisant, null = aucune commande en cours (cohérent avec
  // orderSufficiencyReasoning ci-dessus). Ajouté le 21/09/2026 : sans ce booléen séparé, le
  // frontend ne pouvait décider d'afficher un badge QUE si insuffisant (demande explicite :
  // "si c'est bon je propose rien, sinon j'ai un badge") sans reparser le texte du message.
  orderSufficient           Boolean? @map("order_sufficient")

  // Instantané du stock et de la vente moyenne au moment de la génération, pour affichage
  // (permet de montrer "stock actuel" et "rupture dans X jours" sans recalcul en temps réel).
  stockAtGeneration      Float? @map("stock_at_generation")
  avgWeeklySales         Float? @map("avg_weekly_sales")
  daysUntilStockout      Float? @map("days_until_stockout")
  sellingPrice           Float? @map("selling_price")
  buyingPrice            Float? @map("buying_price")

  // Part du CA de l'article dans le CA total du magasin, sur la période de référence configurée
  // (ReassortConfig.revenueSharePeriodDays), en pourcentage (ex: 3.5 = 3.5%).
  revenueSharePct Float? @map("revenue_share_pct")

  // Le stock RPOS était négatif au moment de la génération (anomalie de suivi : l'article
  // continue de se vendre alors que le stock système indique qu'il n'y en a plus). Ne se corrige
  // que via une intégration de facture (réception de commande) ou un inventaire physique côté
  // RPOS. La quantité proposée est alors basée uniquement sur la vente moyenne, sans stock déduit.
  hadNegativeStock Boolean @default(false) @map("had_negative_stock")

  // Stock brut RPOS avant écrasement à 0 (quand hadNegativeStock=true et que la config ramène le
  // stock à 0 pour le calcul) : conservé pour affichage réel de l'anomalie, même si stockAtGeneration
  // vaut 0 dans ce cas.
  actualStock Float? @map("actual_stock")

  // Stock DLV retiré de stockAtGeneration au moment du calcul (demande du 22/09/2026, cf.
  // schema.prisma#ProductEndOfLife) : présent uniquement si une partie du stock RPOS de cet article
  // était basculée sur un EAN DLV distinct — null si aucune DLV active pour cet article.
  dlvStock Float? @map("dlv_stock")

  // Rayon (2e niveau de la hiérarchie department RPOS, ex: "LIQUIDES", "SAC A LA VENTE"), utilisé
  // pour créer une commande fournisseur distincte par rayon à la validation (readme §11).
  department String? @map("department")

  // Secteur (1er niveau de la hiérarchie department RPOS, ex: "PRODUITS SECS", "BAZAR") :
  // uniquement pour la navigation UI à deux niveaux (secteur > rayon > articles), n'a pas d'effet
  // sur le découpage des commandes fournisseur (toujours par department/rayon, cf. ci-dessus).
  sector String? @map("sector")

  // L'article a-t-il été décoché (exclu) par l'utilisateur lors de la validation ?
  wasExcluded Boolean @default(false) @map("was_excluded")

  // Si wasExcluded=true, l'exclusion vient-elle du forçage sécurité par périmètre de rayon
  // (Rayonniste/Chef de département validant une proposition contenant des lignes hors de son
  // périmètre, cf. proposals.js route POST /proposal/:id/validate) plutôt que d'un vrai rejet
  // métier volontaire ? Sans cette distinction, un taux de rejet agrégé (KPI §23) est totalement
  // faussé par ce filtrage de sécurité qui n'a rien à voir avec la qualité des recommandations IA.
  excludedOutOfScope Boolean @default(false) @map("excluded_out_of_scope")

  // Précision des prévisions (readme §17) : quantité réellement vendue sur la fenêtre de mesure
  // (ReassortConfig.forecastAccuracyWindowDays) après la validation, calculée une seule fois à la
  // demande puis mise en cache ici (la période mesurée est figée dans le passé, jamais recalculée).
  actualSalesQuantity  Float?    @map("actual_sales_quantity")
  actualSalesFetchedAt DateTime? @map("actual_sales_fetched_at")

  // Intrants du calcul de quantité proposée, persistés pour reconstruire l'explication détaillée
  // (évolution : "pourquoi cette quantité ?") sans dépendre d'un recalcul a posteriori qui pourrait
  // donner un résultat différent si le stock ou la config a changé depuis.
  currentOrderedQuantity Float? @map("current_ordered_quantity")
  orderingUnit           Float? @map("ordering_unit")
  cumulativePct          Float? @map("cumulative_pct")

  // Si vrai, cet article a été exclu de cette proposition car déjà présent dans une commande de
  // cette plateforme non encore reçue (cf. ProposalOrder.receptionStatus). Contrairement à
  // l'exclusion binaire historique (l'article n'apparaît alors pas du tout), ce champ permet de
  // documenter pourquoi un article attendu manque de la liste plutôt que de laisser un silence.
  excludedAsAlreadyOrdered Boolean @default(false) @map("excluded_as_already_ordered")

  // Référence et date de la commande créée par cette plateforme responsable de quantityInTransit,
  // affichées à côté du badge "Déjà commandé" pour indiquer où retrouver cette commande dans RPOS.
  platformOrderReference String? @map("platform_order_reference")
  platformOrderDate      DateTime? @map("platform_order_date")

  // Comme excludedAsAlreadyOrdered, mais pour une commande déjà en cours côté RPOS indépendante
  // de cette plateforme (current_ordered_quantity brut, ex: commande manuelle ou fournisseur
  // classique) : sans ce champ, un article à fort CA pouvait disparaître silencieusement de la
  // proposition, ce qui a déjà été pris à tort pour une erreur du calcul de part de CA.
  excludedAsAlreadyOrderedRpos Boolean @default(false) @map("excluded_as_already_ordered_rpos")

  // Référence, date et nombre de commandes RPOS récentes (≤ 7 jours, hors plateforme) non encore
  // livrées pour cet article, affichées à côté du badge "Déjà en commande (RPOS)" quand
  // excludedAsAlreadyOrderedRpos=true, pour indiquer où et quand cette commande a été passée.
  rposOrderReference String? @map("rpos_order_reference")
  rposOrderDate      DateTime? @map("rpos_order_date")
  rposOrderCount     Int? @map("rpos_order_count")
  // Statut RPOS de cette commande (1=en préparation, 2=validée/en attente de livraison,
  // 6=annulée) : affiché à côté de la référence pour dire si la commande bloquante a réellement
  // été transmise à l'entrepôt, pas seulement créée dans RPOS.
  rposOrderStatus    Int? @map("rpos_order_status")

  // Quantité qui aurait été proposée si on ignorait la commande RPOS récente ci-dessus, pour
  // préremplir la saisie côté magasin s'il choisit de débloquer l'article et de commander quand
  // même (readme évolution : "donner la possibilité de débloquer l'article").
  quantityIfUnblocked Float? @map("quantity_if_unblocked")

  // Quantité déjà en commande (en transit, pas encore reçue) pour cet article au moment de la
  // génération, affichée à côté du badge "Déjà en commande" quand excludedAsAlreadyOrdered=true.
  quantityInTransit Float? @map("quantity_in_transit")

  // Saisonnalité (readme §8) : la vente moyenne prévue a-t-elle été ajustée par rapport à la
  // même période N années en arrière, et de quel écart (en %, positif = tendance à la hausse).
  seasonalityAdjusted     Boolean @default(false) @map("seasonality_adjusted")
  seasonalityDeviationPct Float?  @map("seasonality_deviation_pct")

  // Méthode utilisée pour prévoir avgWeeklySales : "flat" (moyenne plate sur la période, par
  // défaut) ou "smoothed" (lissage exponentiel, si config.forecastEnabled=true et historique
  // suffisant — cf. forecastService.js). Affiché en badge sur la proposition.
  forecastMethod String @default("flat") @map("forecast_method")

  // true si le besoin a été réparti selon le profil de vente par jour de semaine de l'article
  // (weekdayFactors non null, computeWeekdayFactors dans forecastService.js), plutôt qu'une
  // répartition uniforme sur la semaine — évolution "modélisation jour de semaine", 22/09/2026.
  // Affiché en badge sur la proposition (purchase-order.html), même convention que
  // seasonalityAdjusted/forecastMethod ci-dessus.
  weekdayAdjusted Boolean @default(false) @map("weekday_adjusted")

  // Ventes agrégées par jour sur la période d'analyse (JSON: [{date, quantity}]), pour donner à
  // l'analyse IA (aiForecastService.js) la vraie évolution de l'article plutôt qu'une seule
  // moyenne plate — lui permet de repérer elle-même une tendance ou un pic ponctuel avant de
  // proposer une quantité. Non affiché tel quel côté UI (le graphique d'évolution de l'article
  // interroge RPOS/la base séparément, cf. productAnalyticsService.js).
  dailyHistory String? @map("daily_history")

  // Détection d'anomalies (CAHIER_DES_CHARGES.md §30-31, étape 7) : signaux calculés à la
  // génération par anomalyService.js (JSON: [{type, changePct, message}]), et catégorie de
  // tendance générale de l'article sur la période analysée. Alimentent le score de confiance
  // (dataQuality, cf. confidenceService.js) et l'analyse IA à la demande — jamais utilisés pour
  // bloquer automatiquement une commande à cette étape (§69 : en cas de doute, ne pas commander
  // automatiquement n'est pertinent qu'à partir de l'auto-réassort, pas encore actif ici).
  anomalies         String? @map("anomalies") // JSON: [{type, changePct, message}]
  trendCategory     String? @map("trend_category") // GROWING | DECLINING | STABLE | VOLATILE | UNKNOWN
  trendChangePct    Float?  @map("trend_change_pct")

  @@map("proposal_lines")
}

// =============================================
// CONFIGURATION SYSTÈME
// =============================================
model SystemConfig {
  id          String @id @default(cuid())
  key         String @unique
  value       String
  description String?

  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// =============================================
// CACHE DERNIER ACHAT / DERNIÈRE VENTE PAR PRODUIT
// =============================================
// Évite de re-solliciter RPOS à chaque affichage de la page de proposition : la première
// consultation du jour interroge RPOS et stocke le résultat ici, les rechargements suivants
// (même jour) lisent le cache. Durée de vie configurable dans les Paramètres.
model ProductInsightCache {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")
  productId  String @map("rpos_product_id")

  lastPurchaseDate     DateTime? @map("last_purchase_date")
  lastPurchaseQuantity Float?    @map("last_purchase_quantity")
  lastPurchaseOrderRef String?   @map("last_purchase_order_ref")

  lastSaleDate     DateTime? @map("last_sale_date")
  lastSaleQuantity Float?    @map("last_sale_quantity")

  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([rposPosId, rposShopId, productId])
  @@map("product_insight_cache")
}

// =============================================
// VENTES SYNCHRONISÉES LOCALEMENT
// =============================================
// Copie locale des lignes de vente RPOS (/api/product_line/), pour ne plus jamais attendre
// plusieurs minutes de pagination RPOS à chaque génération de proposition ou consultation du
// graphique d'évolution d'un article. Alimentée en tâche de fond par salesSyncJob.js
// (synchronisation incrémentale : ne récupère que les ventes depuis la dernière synchro de
// chaque magasin, jamais tout l'historique à chaque fois). Le calcul métier (Pareto, CA de
// référence, historique par article) lit cette table au lieu d'appeler RPOS en direct.
model SalesLine {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")

  ean   String
  label String?
  date  DateTime // date réelle de la vente côté RPOS (pas la date de synchronisation)

  quantity       Float
  revenueExclTax Float  @map("revenue_excl_tax")
  // TTC (RPOS renvoie déjà total_incl_tax en plus de total_excl_tax, aucun appel réseau
  // supplémentaire nécessaire) : nullable car les lignes synchronisées avant l'ajout de ce champ
  // n'en disposent pas — ne pas les traiter comme "0 CFA de TTC", qui serait faux.
  revenueInclTax Float? @map("revenue_incl_tax")

  // UUID du ticket de caisse RPOS (receipt.id) — ajouté le 16/09/2026 pour compter le vrai "nombre
  // de ventes" (tickets distincts), demande explicite car une ligne = un article vendu, pas un
  // ticket (un même ticket a plusieurs lignes). Nullable : les lignes synchronisées avant l'ajout
  // de ce champ n'en disposent pas, jamais traitées comme "0 ticket" (qui serait faux), simplement
  // exclues d'un comptage de tickets sur une période qui couvre en partie des données anciennes.
  receiptId String? @map("receipt_id")

  syncedAt DateTime @default(now()) @map("synced_at")

  // Clé de déduplication approximative : RPOS ne renvoie aucun identifiant unique par ligne de
  // vente dans /api/product_line/, donc on compose une clé à partir des champs disponibles. Risque
  // résiduel très faible mais non nul : deux ventes du même article, même quantité, même CA, à la
  // même seconde exacte, seraient confondues et l'une des deux ignorée (skipDuplicates) — accepté
  // en connaissance de cause plutôt que d'accumuler de vrais doublons à chaque re-synchronisation.
  dedupKey String @unique @map("dedup_key")

  // Les deux filtres systématiquement utilisés côté métier : période seule (Pareto, CA de
  // référence) et période + article (historique/évolution d'un article donné).
  @@index([rposShopId, date])
  @@index([rposShopId, ean, date])
  @@map("sales_lines")
}

// Dernière date synchronisée par magasin (pas par ligne : une seule marque d'avancement par
// magasin), pour que salesSyncJob sache à partir d'où reprendre sans tout retélécharger.
model SalesSyncState {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @unique @map("rpos_shop_id")

  lastSyncedUntil DateTime? @map("last_synced_until")
  lastSyncStatus  String?   @map("last_sync_status") // 'ok' | 'error'
  lastSyncError   String?   @map("last_sync_error")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("sales_sync_state")
}

// Enregistrement EXPLICITE des périodes disponibles/manquantes, jour par jour (demande du
// 21/09/2026 : "il faut également enregistrer dans la base les périodes pour lesquelles les
// données sont disponibles ou manquantes... si les ventes du 10/09/2026 sont récupérées seulement
// à 50%, le système doit être capable de détecter que certaines données sont absentes"). Distinct
// de SalesBackfillChunk (qui trace une TRANCHE, souvent plusieurs jours, sans jamais dire si CHAQUE
// jour à l'intérieur est complet) : une ligne par (magasin, jour) donne la granularité exacte
// demandée, alimentée par le récap automatique en fin de backfill/synchro (cf.
// salesDailyCoverageService.js).
model SalesDailyCoverage {
  id String @id @default(cuid())

  rposPosId  String   @map("rpos_pos_id")
  rposShopId String   @map("rpos_shop_id")
  day        DateTime @map("day") // toujours à minuit UTC (une date, pas un horodatage précis)

  expectedLines Int @map("expected_lines") // count() RPOS réel pour CETTE journée précise
  actualLines   Int @map("actual_lines")   // count() réel en base (SalesLine) pour cette même journée

  // COMPLETE (actual >= expected) | PARTIAL (0 < actual < expected) | MISSING (actual = 0, expected > 0)
  // | NO_SALES (expected = 0, jour sans aucune vente RPOS — jamais confondu avec une vraie lacune).
  status String @map("status")

  checkedAt DateTime @default(now()) @map("checked_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rposShopId, day])
  @@index([rposShopId, status])
  @@map("sales_daily_coverage")
}

// =============================================
// RÉCUPÉRATION PAR TRANCHES AVEC REPRISE (backfill volumineux)
// =============================================
// Persiste la progression d'une récupération historique volumineuse (des millions de lignes sur
// plusieurs mois), découpée en tranches temporelles pour rester sous la limite RPOS par appel.
// Contrairement à SalesSyncState (une seule marque d'avancement par magasin, pour la synchro
// incrémentale courante), ce modèle trace CHAQUE tranche d'UN run de récupération donné, pour
// pouvoir reprendre exactement là où une interruption (crash, redéploiement, coupure réseau) a
// arrêté le travail, sans jamais retélécharger une tranche déjà terminée ni perdre la progression
// d'une tranche partiellement récupérée.
model SalesBackfillRun {
  id String @id @default(cuid())

  rposPosId  String @map("rpos_pos_id")
  rposShopId String @map("rpos_shop_id")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // Estimé une seule fois au lancement du run (comptage RPOS sur la période complète), sert à
  // dimensionner le nombre et la taille des tranches — pas mis à jour ensuite même si le total
  // réel diverge légèrement une fois toutes les tranches récupérées (cf. totalFetchedLines).
  estimatedTotalLines Int @map("estimated_total_lines")
  totalChunks         Int @map("total_chunks")

  status String @default("IN_PROGRESS") @map("status") // IN_PROGRESS | PAUSED | DONE | ERROR

  // Drapeau coopératif : posé par l'action "Mettre en pause" côté UI, lu par la boucle de
  // traitement entre deux pages RPOS pour s'arrêter proprement dès que possible (pas au milieu
  // d'une page en cours) plutôt que de tuer le process — la progression déjà persistée (pages et
  // tranches terminées) reste intacte, une reprise ultérieure repart exactement de là.
  pauseRequested Boolean @default(false) @map("pause_requested")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  chunks SalesBackfillChunk[]

  // Si ce run fait partie d'un lot multi-magasins (bouton "Tout cocher"), pointe vers le batch qui
  // le pilote — permet au traitement séquentiel de continuer côté serveur même si l'utilisateur
  // ferme l'onglet ou recharge la page (avant cet ajout, la file d'attente tournait entièrement en
  // JS navigateur : quitter la page arrêtait tous les magasins restants sans que rien ne le
  // signale, le run en cours seul continuait jusqu'au bout côté serveur).
  batchId String?           @map("batch_id")
  batch   SalesBackfillBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Un seul run actif à la fois par magasin : une reprise doit retrouver ce run existant plutôt
  // que d'en créer un nouveau en parallèle qui retéléchargerait les mêmes tranches.
  @@index([rposShopId, status])
  @@index([batchId])
  @@map("sales_backfill_runs")
}

// Lot de récupération multi-magasins (bouton "Tout cocher" côté UI) : la liste des cibles est
// figée au lancement, puis le serveur enchaîne un SalesBackfillRun par magasin, un par un, sans
// dépendre de la page restée ouverte dans le navigateur. Au plus un batch actif à la fois (imposé
// en code, pas en contrainte DB) pour ne jamais paralléliser plusieurs lots entre eux.
model SalesBackfillBatch {
  id String @id @default(cuid())

  // Liste des cibles [{ posId, shopId, shopLabel }], figée au lancement — ne change jamais après
  // coup même si la liste des magasins actifs évolue en cours de route.
  targetsJson String @map("targets_json")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  status String @default("IN_PROGRESS") @map("status") // IN_PROGRESS | DONE | CANCELLED

  // Index (0-based) dans targetsJson du magasin en cours de traitement — permet de reconstruire
  // "magasin X/Y" côté UI sans avoir à recompter les runs terminés à chaque affichage.
  currentIndex Int @default(0) @map("current_index")

  cancelRequested Boolean @default(false) @map("cancel_requested")

  // Magasins qui ont échoué avant même de pouvoir créer un SalesBackfillRun (ex: comptage du volume
  // initial impossible car le serveur RPOS était injoignable) — sans ce champ, cet échec n'était
  // visible que dans les logs serveur, perdu dès qu'on les cherchait après coup. JSON:
  // [{ posId, shopId, shopLabel, periodStart, periodEnd, message, failedAt }]. periodStart/periodEnd
  // dupliquent volontairement ceux du batch (jamais différents pour l'instant) pour que ce champ
  // reste auto-suffisant si un jour une relance ciblée change la période effectivement retentée.
  failuresJson String @default("[]") @map("failures_json")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  runs SalesBackfillRun[]

  @@map("sales_backfill_batches")
}

model SalesBackfillChunk {
  id String @id @default(cuid())

  runId String @map("run_id")
  run   SalesBackfillRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  chunkIndex  Int      @map("chunk_index") // 1-based, ordre de traitement
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  expectedLines Int @default(0) @map("expected_lines") // count() RPOS réel sur la période de CETTE tranche
  fetchedLines  Int @default(0) @map("fetched_lines")  // cumul des lignes effectivement insérées

  // Curseur de reprise intra-tranche : dernière page RPOS insérée avec succès. Si le process est
  // interrompu à la page 15/35, la reprise redemande la page 16, pas la tranche entière.
  lastPageCompleted Int? @map("last_page_completed")

  status String @default("PENDING") @map("status") // PENDING | IN_PROGRESS | DONE | ERROR
  errorMessage String? @map("error_message")

  // Nombre de tentatives déjà effectuées sur cette tranche (demande du 21/09/2026 : "combien de
  // tentatives ont été effectuées") — incrémenté à chaque échec, avant retry automatique. Distinct
  // d'un simple compteur de pages : une tentative repart de lastPageCompleted+1 (jamais depuis le
  // début de la tranche), donc ce compteur reflète le nombre d'essais, pas le volume retélécharché.
  retryCount Int @default(0) @map("retry_count")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([runId, chunkIndex])
  @@map("sales_backfill_chunks")
}

// =============================================
// Prévision par IA (LLM) — readme évolution "intégration IA"
// =============================================

// Clé API d'un fournisseur IA (Gemini, OpenAI, Anthropic...), configurée entièrement depuis l'UI
// (Paramètres > IA) plutôt que via une variable d'environnement, pour que l'utilisateur puisse
// ajouter/changer de fournisseur ou de clé sans redéploiement. Plusieurs clés peuvent coexister
// (même fournisseur ou non) : la génération essaie la clé de plus haute priorité en premier, et
// bascule automatiquement sur la suivante en cas d'échec (quota épuisé, erreur d'authentification).
model AiProviderKey {
  id String @id @default(cuid())

  provider String // "gemini" | "openai" | "anthropic" — détermine le format d'appel API utilisé
  label    String // nom donné par l'utilisateur pour s'y retrouver (ex: "Gemini principal", "OpenAI secours")

  // Stockée chiffrée (AES-256-GCM, cf. cryptoService.js) : jamais renvoyée en clair par l'API,
  // seul un aperçu masqué (4 derniers caractères) est affiché côté UI après la sauvegarde initiale.
  encryptedApiKey String @map("encrypted_api_key")

  model String? // modèle précis à utiliser (ex: "gemini-2.0-flash"), optionnel : défaut par fournisseur si vide

  priority Int     @default(0) // ordre d'essai, plus petit = essayé en premier
  isActive Boolean @default(true) @map("is_active")

  lastUsedAt    DateTime? @map("last_used_at")
  lastError     String?   @map("last_error")
  lastErrorAt   DateTime? @map("last_error_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  usageLogs AiUsageLog[]

  @@map("ai_provider_keys")
}

// Suivi de consommation de tokens par appel LLM réussi (demande du 21/09/2026 : "j'ai l'impression
// qui fini assez rapidement... il doit voir l'utilisation et ce qui reste, sur une période,
// globale") — une ligne par appel, jamais agrégée à l'écriture (l'agrégation par période se fait à
// la lecture, cf. aiUsageService.js) pour garder l'historique détaillé exploitable de plusieurs
// façons (par jour, par fournisseur, par clé précise) sans avoir à re-décider a priori quelle
// granularité sera utile plus tard.
model AiUsageLog {
  id String @id @default(cuid())

  providerKeyId String?        @map("provider_key_id")
  providerKey   AiProviderKey? @relation(fields: [providerKeyId], references: [id], onDelete: SetNull)

  provider String // "gemini" | "openai" | "anthropic" — dupliqué depuis providerKey (jamais perdu si la clé est supprimée ensuite)
  model    String? // modèle réellement utilisé pour cet appel

  promptTokens     Int @map("prompt_tokens")     // tokens d'entrée (prompt envoyé)
  completionTokens Int @map("completion_tokens") // tokens de sortie (réponse générée)
  totalTokens      Int @map("total_tokens")

  // Contexte de l'appel (ex: "chatbot", "forecast", "improvement") — permet de voir plus tard QUEL
  // usage de la plateforme consomme le plus, pas seulement le total brut.
  context String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([providerKeyId, createdAt])
  @@map("ai_usage_logs")
}

// Résultat d'une analyse IA "à la demande" sur une proposition : garde une trace de ce qui a été
// envoyé/reçu du LLM par article, séparément de la proposition classique (ProposalLine), pour ne
// jamais écraser le calcul standard tant que l'utilisateur n'a pas explicitement choisi d'utiliser
// la suggestion IA à la validation.
model AiForecastRun {
  id String @id @default(cuid())

  proposalId String  @map("proposal_id")
  rposShopId String  @map("rpos_shop_id")

  providerUsed String? @map("provider_used") // quel fournisseur a effectivement répondu (après fallback éventuel)
  status       String  @default("PENDING") @map("status") // PENDING | RUNNING | DONE | ERROR
  errorMessage String? @map("error_message")

  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")
  requestedBy String?   @map("requested_by")

  lines AiForecastLine[]

  @@map("ai_forecast_runs")
}

model AiForecastLine {
  id String @id @default(cuid())

  runId String        @map("run_id")
  run   AiForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  ean               String
  label             String?
  quantitySuggested Float  @map("quantity_suggested")
  reasoning         String? // courte justification renvoyée par le LLM, affichée à titre indicatif

  @@map("ai_forecast_lines")
}

// =============================================
// ASSISTANT IA — HISTORIQUE DES CONVERSATIONS (CAHIER_DES_CHARGES.md §34-38, étape 11)
// =============================================
// Une conversation par fil de discussion ouvert (comme ChatGPT) : rattachée à un utilisateur (pas
// seulement un magasin, pour ne jamais mélanger l'historique de deux comptes qui partagent un même
// magasin) et à un magasin précis (le contexte ne change pas en cours de conversation — changer de
// magasin ouvre une nouvelle conversation, plus simple à raisonner que migrer un fil en cours).
model ChatbotConversation {
  id String @id @default(cuid())

  userId     String @map("user_id")
  rposShopId String @map("rpos_shop_id")

  // Titre affiché dans la liste des conversations : la première question posée, tronquée — jamais
  // généré par un appel LLM séparé (coût/latence inutile pour un simple titre de liste).
  title String

  department    String? // rayon sélectionné au moment de la création de cette conversation
  subDepartment String? @map("sub_department")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatbotMessage[]

  @@index([userId, updatedAt])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String               @id @default(cuid())
  conversationId String               @map("conversation_id")
  conversation   ChatbotConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // "user" | "assistant"
  content String

  // Renseigné uniquement sur les messages "assistant" : quel outil a été utilisé pour répondre
  // (chatbotToolsService.js), pour audit/debug — jamais affiché tel quel à l'utilisateur final.
  toolUsed String? @map("tool_used")

  // Résultat brut (JSON stringifié) de l'outil appelé pour ce message, quand il y en a un : permet
  // de reconstruire le tableau/graphique associé à la réponse à la réouverture de la conversation,
  // sans jamais redemander ce rendu au LLM (qui pourrait le déformer en le redécrivant).
  toolResult String? @map("tool_result")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chatbot_messages")
}

// Conseiller d'amélioration IA (première brique de l'AI Center, §44) : chaque ligne = un constat
// du chien de garde (détecteurs déterministes d'improvementService.js) + la recommandation qui
// va avec (réglage d'exploitation et/ou reco dev, enrichie par LLM quand disponible).
// Boucle d'apprentissage : metricName/metricBefore figent la mesure au constat ; quand la reco
// est marquée APPLIED, une évaluation ultérieure recalcule la métrique (metricAfter) et statue
// IMPROVED (baisse ≥10%) ou NO_EFFECT — le système apprend ce qui marche vraiment.
model AIImprovement {
  id String @id @default(cuid())

  // SILENT_ANOMALY (anomalie silencieuse : prédiction non évaluable, job qui dérive...),
  // ACCURACY (précision/biais par magasin), JOB_HEALTH, DATA_QUALITY, CHATBOT_GAP, WORKFLOW.
  type String
  // INFO | WARNING | CRITICAL
  severity String
  title    String
  // Recommandation d'exploitation (texte déterministe, éventuellement enrichi par LLM).
  detail String
  // Recommandation dev (fichiers/pistes de correctif), si le constat relève du code.
  devRecommendation String? @map("dev_recommendation")
  // Preuve chiffrée (JSON) : effectifs, exemples, paramètres de recalcule de la métrique.
  evidence String?
  // Périmètre : "global" ou rposShopId.
  scope String @default("global")
  // PROPOSED -> IN_PROGRESS -> TO_VERIFY -> APPLIED, puis IMPROVED | NO_EFFECT après
  // évaluation ; DISMISSED à tout moment (avec motif). Voir AIImprovementEvent pour la timeline.
  status    String    @default("PROPOSED") // PROPOSED | IN_PROGRESS | TO_VERIFY | APPLIED | DISMISSED | IMPROVED | NO_EFFECT
  appliedAt DateTime? @map("applied_at")

  // Priorité de traitement : CRITICAL (bloquant) | HIGH (intervention rapide) |
  // MEDIUM (à traiter, non bloquant) | LOW (amélioration mineure). Dérivée de la sévérité
  // à la création.
  priority String @default("MEDIUM")
  // Message d'erreur EXACT constaté (ex: dernière erreur du job) — jamais reformulé, pour
  // vérification précise sans interprétation de l'IA.
  errorMessage String? @map("error_message")
  // Confiance de l'analyse IA (0-100) quand enrichie par LLM, null sinon.
  aiConfidence Int? @map("ai_confidence")

  metricName   String? @map("metric_name")
  metricBefore Float?  @map("metric_before")
  metricAfter  Float?  @map("metric_after")

  providerUsed String? @map("provider_used")

  // Transparence IA (demande du 14/09/2026) : le prompt exact envoyé au LLM (comportement
  // décrit + preuves) est conservé pour audit, ainsi que le message d'erreur quand
  // l'enrichissement a échoué (pas de clé, quota, réseau) et que la reco est restée déterministe.
  aiPrompt String? @map("ai_prompt")
  aiError  String? @map("ai_error")

  // Contexte de détection (traçabilité Qui/Où/Quand) : qui a lancé l'analyse (email ou
  // "system/cron"), IP source, version appli, environnement.
  detectedBy  String? @map("detected_by")
  detectedIp  String? @map("detected_ip")
  appVersion  String? @map("app_version")
  environment String? @default("production")
  // Suivi humain : qui a appliqué, ce qui a réellement été fait, pourquoi ignoré.
  appliedBy       String? @map("applied_by")
  appliedNote     String? @map("applied_note")
  dismissedBy     String? @map("dismissed_by")
  dismissedReason String? @map("dismissed_reason")

  events AIImprovementEvent[]

  // Erreurs du journal regroupées dans ce constat (clic journal → correctif).
  errorReports ErrorReport[]

  // Entrée du journal unifié de corrections créée quand ce constat passe à APPLIED/IMPROVED
  // (cf. CorrectionRecord, source AI_AUTO) — 0 ou 1, jamais recréée à chaque évaluation.
  correctionRecords CorrectionRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([type, scope, status])
  @@index([priority, status])
  @@map("ai_improvements")
}

// Timeline d'une recommandation (traçabilité complète : Détection → Analyse IA →
// Recommandation → Validation → Correction → Vérification → Résultat). Chaque transition de
// statut et chaque évaluation y laisse une trace horodatée avec son acteur.
model AIImprovementEvent {
  id String @id @default(cuid())

  improvementId String         @map("improvement_id")
  improvement   AIImprovement  @relation(fields: [improvementId], references: [id], onDelete: Cascade)

  at DateTime @default(now())
  // Email de l'utilisateur, ou "system" pour les actions automatiques (détection, évaluation).
  actor String @default("system")
  // DETECTED | ENRICHED | STATUS_CHANGED | EVALUATED
  action String
  fromStatus String? @map("from_status")
  toStatus   String? @map("to_status")
  // Détail libre : motif d'ignorance, correction réellement effectuée, mesure avant→après...
  note String?

  @@index([improvementId, at])
  @@map("ai_improvement_events")
}

// Journal unifié des corrections (demande du 17/09/2026 : "à chaque correction, l'erreur exacte
// constatée, son contexte, la cause identifiée, la correction apportée, les fichiers/fonctions
// concernés, les tests avant/après, et l'historique des corrections similaires"). Couvre deux
// sources différentes dans UN SEUL journal (choix explicite plutôt que deux journaux séparés) :
//   - AI_AUTO : une correction détectée et appliquée automatiquement par le chien de garde
//     (AIImprovement passé à APPLIED/IMPROVED) — improvementId renseigné, lien vers son evidence.
//   - DEV_FIX : une correction de code faite en développement (par Claude ou un développeur) —
//     improvementId absent, saisie manuelle au moment du fix.
// domain reprend la granularité des capacités déjà utilisées pour le RBAC IA (aiPermissionsService.js
// CAPABILITIES : stock, sales, orders, accuracy, revenueShop, revenueArticle, articleDetails), avec
// "code" en repli pour un correctif transverse qui ne se rattache à aucune capacité précise — jamais
// une nouvelle taxonomie inventée en parallèle qui divergerait de celle déjà utilisée pour la
// maîtrise par domaine (AIDomainMastery) et le RBAC.
model CorrectionRecord {
  id String @id @default(cuid())

  source String // AI_AUTO | DEV_FIX

  improvementId String?        @map("improvement_id")
  improvement   AIImprovement? @relation(fields: [improvementId], references: [id], onDelete: SetNull)

  domain String // capacité concernée (cf. aiPermissionsService.CAPABILITIES), ou "code"

  errorObserved String @map("error_observed")
  context        String
  rootCause      String @map("root_cause")
  fixApplied     String @map("fix_applied")

  filesChanged     String @map("files_changed")     // JSON: string[]
  functionsChanged String @map("functions_changed") // JSON: string[]

  testsBefore String @map("tests_before")
  testsAfter  String @map("tests_after")

  // Liens vers des CorrectionRecord antérieurs jugés similaires (même domaine, cause proche) —
  // renseigné à la création par correctionRecordService.findSimilar, jamais recalculé après coup :
  // une correction future qui cite CELLE-CI comme similaire ne modifie pas cette liste rétroactivement.
  similarPastCorrectionIds String? @map("similar_past_correction_ids") // JSON: string[]

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @default("system") @map("created_by")

  @@index([domain])
  @@index([source])
  @@index([createdAt])
  @@map("correction_records")
}

// Mémoire de maîtrise par domaine métier (demande du 17/09/2026 : "vérifier s'il maîtrise
// correctement chaque partie de la logique métier, connaître son niveau de maîtrise par domaine").
// Granularité = les capacités déjà utilisées pour le RBAC IA (aiPermissionsService.CAPABILITIES),
// plus "code" pour les correctifs transverses — jamais une taxonomie parallèle (cf. CorrectionRecord).
// Une seule ligne par domaine (@unique), recalculée périodiquement par aiMasteryService.js — jamais
// un historique de lignes, ce modèle représente l'état ACTUEL de la maîtrise, pas son évolution
// (l'évolution se lit dans CorrectionRecord.createdAt, déjà horodaté).
//
// Deux méthodes de calcul cohabitent (choix assumé le 17/09/2026, pas une simplification par
// défaut) :
//  - domain = "accuracy" : vraie vérité-terrain disponible (AIPredictionOutcome compare la quantité
//    prédite à la vente réelle) — masteryScore dérivé de l'erreur moyenne réelle.
//  - tous les autres domaines : AUCUNE vérité-terrain n'existe aujourd'hui (juste des lectures
//    instantanées sans historique de justesse, ex: getStockoutRisks ne vérifie jamais après coup si
//    la rupture prédite s'est produite) — masteryScore dérivé du volume et de l'ancienneté des
//    CorrectionRecord sur ce domaine (une correction récente pénalise plus qu'une correction
//    ancienne). Moins précis qu'une vraie vérité-terrain, mais honnête sur ce qui est réellement
//    mesuré plutôt que d'afficher un chiffre qui n'aurait pas de vrai sens.
model AIDomainMastery {
  id String @id @default(cuid())

  domain String @unique

  masteryScore    Float @default(100) @map("mastery_score") // 0-100
  confidenceScore Float @default(0)   @map("confidence_score") // 0-100 : bas si peu d'observations, même si masteryScore est haut

  // Méthode ayant produit masteryScore pour cette ligne — traçabilité pour ne jamais confondre un
  // score "vérité-terrain" avec un score "volume de corrections" en lisant seulement le chiffre.
  method String @default("CORRECTION_VOLUME") // ACCURACY_OUTCOME | CORRECTION_VOLUME

  totalObservations Int @default(0) @map("total_observations") // AIPredictionOutcome évalués (accuracy) ou décisions connues (autres)
  errorCount        Int @default(0) @map("error_count")
  correctionCount   Int @default(0) @map("correction_count") // CorrectionRecord liés à ce domaine, tous historiques confondus

  knownIssuesJson String? @map("known_issues_json") // JSON: résumé des erreurs récurrentes connues (libellés + fréquence)

  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("ai_domain_mastery")
}

// Score de préparation à l'autonomie (demande du 17/09/2026) : indicateur CONSULTATIF (choix validé
// le 17/09/2026, pas de bascule automatique de comportement) mesurant si le système est prêt à
// fonctionner avec moins de supervision humaine — jamais un interrupteur qui déclenche seul un
// changement réel : AI_QUANTITY_ADJUSTMENT_ENABLED (systemConfigService.js) reste le seul réglage qui
// affecte vraiment le comportement, décidé par un humain qui consulte ce score.
//
// 7 critères demandés, chacun 0-100 quand mesurable :
//   - errorRateScore : dérivé d'AIPredictionOutcome (taux d'erreur > seuil) + CorrectionRecord
//   - recommendationAccuracyScore : dérivé d'AIPredictionOutcome (accuracyPct), même base qu'AIDomainMastery.accuracy
//   - stabilityScore : dérivé de la variance des percentageError récents (une IA erratique, même en
//     moyenne correcte, n'est pas prête à l'autonomie)
//   - anomalyDetectionScore : dérivé d'AIImprovement type SILENT_ANOMALY (taux confirmé vs DISMISSED)
//   - postCorrectionScore : dérivé d'AIImprovement (taux IMPROVED vs NO_EFFECT après correction)
//   - ruleComplianceScore et testCaseScore : AUCUNE source de données réelle aujourd'hui (pas de
//     journal de violations RBAC dédié, pas de suite de cas de test rejouée) — stockés à `null`
//     explicitement plutôt qu'une valeur inventée, et EXCLUS du calcul de globalScore (moyenne des
//     seuls critères réellement mesurés, jamais une pénalité arbitraire ni un chiffre flatteur creux).
//
// Paliers réversibles avec hystérésis (demande explicite : "débloquée progressivement... atteints ET
// maintenus dans le temps", jamais sur un seul pic) : un palier n'est retenu comme "atteint" que si
// le globalScore reste au-dessus de son seuil sur STABILITY_STREAK_REQUIRED snapshots consécutifs
// (cf. autonomyReadinessService.js) — currentStreakCount trace cette continuité, remise à 0 dès
// qu'un snapshot retombe sous le seuil du palier courant.
model AutonomyReadinessSnapshot {
  id String @id @default(cuid())

  computedAt DateTime @default(now()) @map("computed_at")

  errorRateScore              Float? @map("error_rate_score")
  recommendationAccuracyScore Float? @map("recommendation_accuracy_score")
  stabilityScore              Float? @map("stability_score")
  anomalyDetectionScore       Float? @map("anomaly_detection_score")
  ruleComplianceScore         Float? @map("rule_compliance_score") // toujours null aujourd'hui, cf. commentaire de tête
  postCorrectionScore         Float? @map("post_correction_score")
  testCaseScore               Float? @map("test_case_score") // toujours null aujourd'hui, cf. commentaire de tête

  globalScore Float @map("global_score") // moyenne des critères non-null ci-dessus
  // Nombre de critères réellement entrés dans le calcul de globalScore (sur 7) — affiché dans l'UI
  // pour ne jamais laisser croire à une mesure complète alors que 2 critères manquent aujourd'hui.
  measuredCriteriaCount Int @map("measured_criteria_count")

  // VALIDATION_HUMAINE | SUPERVISION_HUMAINE | AUTONOMIE_CONTROLEE | AUTONOME
  level String
  // Nombre de snapshots consécutifs (ce snapshot inclus) où le score est resté au niveau suffisant
  // pour CE palier — un palier n'est affiché comme réellement "tenu" que si ce compteur dépasse le
  // seuil de continuité requis, jamais sur la base d'un seul snapshot ponctuel.
  currentStreakCount Int @map("current_streak_count")

  detailsJson String @map("details_json") // JSON: détail par domaine (AIDomainMastery), échantillons utilisés

  @@index([computedAt])
  @@map("autonomy_readiness_snapshots")
}

// Détection d'anomalie de commande (demande du 18/09/2026, backend/amelioration.md) : une commande
// déjà passée pour un article ne doit jamais être un simple blocage "0 à proposer" — computeQuantityToOrder
// (proposalService.js) fait déjà cette soustraction correctement. Ce qui manquait : comparer la
// quantité COMMANDÉE (ProposalLine.quantityValidated, l'historique des vraies décisions humaines)
// à l'historique récent pour CE MÊME article/magasin, et signaler un écart statistique important —
// ni trop haut (risque de surstock) ni trop bas (risque de rupture malgré une commande déjà passée).
// Détecté à la GÉNÉRATION (pas à la validation, choix explicite du 18/09/2026 : "je veux que sur le
// UI dans la commande il ait la partie... pas au moment de validation, il doit voir l'info avant"),
// pour que l'alerte soit visible AVANT que l'utilisateur ne valide, jamais après coup.
model OrderAnomaly {
  id String @id @default(cuid())

  rposShopId String @map("rpos_shop_id")
  ean        String
  label      String?

  proposalId String? @map("proposal_id")
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  detectedAt DateTime @default(now()) @map("detected_at")

  newQuantity     Float @map("new_quantity")
  historicalMean  Float @map("historical_mean")
  historicalMin   Float @map("historical_min")
  historicalMax   Float @map("historical_max")
  sampleSize      Int   @map("sample_size") // nombre de commandes passées ayant servi au calcul

  // HIGH (quantité nettement supérieure à l'habitude, risque de surstock) | LOW (nettement
  // inférieure, risque de rupture malgré la commande déjà passée).
  direction String

  // PENDING (jamais vue) -> ACKNOWLEDGED (vue par un humain, contexte accepté tel quel) ->
  // DISMISSED (fausse alerte confirmée, ex: promotion connue). Jamais conclu automatiquement
  // "commande incorrecte" (demande explicite §9 du document) — seul un humain statue.
  status      String  @default("PENDING")
  contextNote String? @map("context_note") // note humaine expliquant l'écart (promo, reprise d'activité...)

  @@index([rposShopId, ean])
  @@index([status, detectedAt])
  @@map("order_anomalies")
}

// Journal des erreurs applicatives (debug global) : TOUTES les erreurs 5xx de l'API et TOUTES
// les erreurs JS non capturées de CHAQUE page frontend y sont persistées avec leur contexte
// (Qui/Où/Quand spec §5). Le détecteur du chien de garde les regroupe (même signature) et en
// fait des recommandations avec le message exact — comme un debug qui ratisse tout le système.
// Rétention : 30 jours + plafond 5000 lignes (élagué à chaque run du watchdog).
model ErrorReport {
  id String @id @default(cuid())

  // "backend" (erreur API 5xx) | "frontend" (erreur JS page).
  source String
  // Page frontend (ex: "/purchase-order") pour source frontend, null côté backend.
  page String?
  // URL/méthode API côté backend (ex: "POST /api/reassort/proposal/generate").
  url    String?
  method String?
  // Code HTTP côté backend (500...), null côté frontend.
  statusCode Int? @map("status_code")
  // Message EXACT, jamais reformulé.
  message String
  // Stack (tronquée) quand disponible.
  stack String?
  // Contexte Qui/Où (spec §5) : email, périmètre magasin, IP, navigateur, version appli.
  userEmail String? @map("user_email")
  shopRef   String? @map("shop_ref")
  ip        String?
  userAgent String? @map("user_agent")

  // Recommandation liée (clic journal → correctif) : posée quand le chien de garde regroupe
  // cette erreur dans un constat. Null = pas (encore) de reco — occurrences insuffisantes
  // (seuil ≥3) ou erreur non reproductible : toutes les erreurs ne sont pas des bugs code.
  improvementId String?         @map("improvement_id")
  improvement   AIImprovement?  @relation(fields: [improvementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([createdAt])
  @@map("error_reports")
}
