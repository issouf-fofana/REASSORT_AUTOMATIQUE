# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration (PostgreSQL) — en Docker Compose, DATABASE_URL est déjà fourni par
# docker-compose.yml (variable "environment" du service backend) et n'a pas besoin d'être répété
# ici ; utile seulement pour lancer le backend hors Docker (dev local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/stock_auto_reappro?schema=public"

# Security
JWT_SECRET="your-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:8080"

# Compte administrateur créé automatiquement au tout premier démarrage (docker-entrypoint.sh →
# prisma/create-admin.js). Sans ces variables : email "admin@reassort.local" et mot de passe fort
# généré aléatoirement, affiché UNE SEULE FOIS dans les logs du conteneur au premier démarrage.
# Idempotent : si un compte ADMIN existe déjà, ADMIN_PASSWORD n'a plus aucun effet (le mot de passe
# n'est jamais réinitialisé automatiquement) — sauf si ADMIN_EMAIL est explicitement redéfini ici,
# auquel cas le mot de passe de CE compte est réécrasé à CHAQUE démarrage du conteneur avec la
# valeur d'ADMIN_PASSWORD. Retirer ces deux variables une fois le compte créé pour pouvoir changer
# le mot de passe depuis l'interface sans qu'il soit écrasé au prochain déploiement.
ADMIN_EMAIL="admin@reassort.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"

# Connexion RPOS (ERP/POS Prosuma) — obligatoire pour toute synchronisation réelle (ventes, stock,
# commandes fournisseur). RPOS_BASE_URL par défaut pointe vers pos1 (voir rposServersService.js
# pour la gestion multi-serveurs pos1..pos18, ajoutée/gérée ensuite depuis Paramètres).
RPOS_BASE_URL="https://pos1-prod-prosuma.prosuma.pos"
RPOS_USER=""
RPOS_PASSWORD=""

# Authentification LDAP (Active Directory Prosuma, STEP 10) : si un utilisateur tente de se
# connecter avec un email @LDAP_DOMAIN_FQDN qui n'a AUCUN compte local, le backend tente un bind
# LDAP avec la partie avant @ comme identifiant réseau. Le compte créé au premier succès reste
# INACTIF (accès refusé par défaut) tant qu'un ADMIN ne l'a pas configuré depuis Utilisateurs
# (rôle/magasin réel, ou recherche annuaire pour le préconfigurer avant même son premier login). Un
# compte local déjà existant (mot de passe local) garde toujours la priorité, LDAP n'intervient
# jamais pour lui.
LDAP_URL="ldap://10.0.70.1"
LDAP_DOMAIN_FQDN="prosuma.ci"
# Vrai nom de domaine Active Directory (peut différer du domaine des emails ci-dessus — constaté en
# pratique chez Prosuma : prosuma.ci pour les emails/UPN, prosuma.lan comme domaine AD réel). Utilisé
# uniquement pour construire le Base DN d'une recherche annuaire (LDAP_BIND_USER/LDAP_BIND_PASSWORD
# ci-dessous) — un mauvais Base DN fait échouer la recherche avec un referral AD (erreur 0000202B),
# jamais l'authentification normale par bind qui n'en a pas besoin. En cas de doute sur la valeur
# exacte, une requête RootDSE anonyme sur le contrôleur de domaine (attribut defaultNamingContext)
# donne la réponse exacte sans devoir le deviner.
LDAP_AD_DOMAIN_FQDN="prosuma.lan"
# Compte de service pour la recherche annuaire (Utilisateurs > "Rechercher dans l'annuaire AD") —
# distinct de l'authentification d'un utilisateur normal, qui n'a pas forcément le droit de lister
# l'annuaire. Sans ces deux variables, la recherche est simplement indisponible.
LDAP_BIND_USER=""
LDAP_BIND_PASSWORD=""

# Tâches planifiées (format cron standard, node-cron) — valeurs ci-dessous = défauts déjà appliqués
# si ces variables sont absentes ; à changer seulement si le rythme métier doit être ajusté.
SALES_SYNC_CRON="*/15 * * * *"
SHOPS_SYNC_CRON="0 * * * *"
RECEPTION_SYNC_CRON="0 * * * *"
NIGHTLY_PROPOSAL_CRON="0 4 * * *"
DAILY_REVIEW_CRON="30 6 * * *"
PREDICTION_OUTCOME_CRON="0 7 * * *"
IMPROVEMENTS_CRON="30 7 * * *"

# Nombre de requêtes IA (LLM) traitées en parallèle (proposition/analyse) — au-delà, mises en file
# d'attente pour ne pas dépasser les limites de débit des fournisseurs (Gemini/OpenAI/Anthropic).
AI_QUEUE_CONCURRENCY=3

# Journalisation
LOG_LEVEL="info"
LOG_FORMAT="text"
